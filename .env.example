# Copy to .env.local (never commit real values).
# Port and bind address. Keep 127.0.0.1 for a single terminal; use 0.0.0.0 only
# if handhelds on the bar's own Wi-Fi need to reach the till.
PORT=3000
HOST=127.0.0.1
# Where the SQLite database and OIS exports live. Back this folder up.
POS_DATA_DIR=./data
# PIN for the first manager account, used once when the database is created.
# If unset, a random PIN is generated and printed to the console on first run.
POS_INITIAL_MANAGER_PIN=
# Set to 1 to start with an empty menu instead of the sample drinks list.
POS_NO_SEED=
